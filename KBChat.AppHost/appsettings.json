{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "EntraId": {
    "ApiClientId": "<client id for api app registration>",
    "FrontEndClientId": "<client id for frontend app registration>",
    "Instance": "https://login.microsoftonline.com/<your tenant id>",
    "BackendScope": "api://<your api app client id>/chat",
    "Audience": "api://<your api app client id>"

  },
  "CosmosDb": {
    "DatabaseName": "kbchat",
    "ContainerName": "history"
  },
  "AzureOpenAI": {
    "CompletionDeploymentName": "gpt-4o",
    "CompletionModelVersion": "2024-11-20",
    "CompletionModelSku": "GlobalStandard",
    "CompletionModelSkuCapacity": 30,
    "EmbeddingDeploymentName": "text-embedding-3-large",
    "EmbeddingModelVersion": "1",
    "EmbeddingModelSku": "GlobalStandard",
    "EmbeddingModelSkuCapacity": 200,
    "EmbeddingVectorDimensions": 3072,
    "SearchIndex": "kbdocs-index"
  },
  "StorageAccount": {
    "BlobEndpoint": "https://<your storage accountname>.blob.core.windows.net/",
    "ResourceId": "<azure resource id of your storage account name>",
    "ContainerName": "kb-docs"

  },
  "ConnectionStrings": {
    "search": "https://<your ai search name>.search.windows.net",
    "openai": "https://<your openai instance>.openai.azure.com/",
    "cosmos": "https://<your cosmos sql instance>.documents.azure.com:443/"

  },
  "SamplePrompts": {
    "Prompts": [
      "What do you know about ...?",
      "Am I allowed to do ...?",
      "What is the policy on ...?",
      "How do I do ...?",
      "What security measures do I need to take for ...?",
      "How do I onboard ...?"
    ]
  },
  "AzureDevOps": {
    "Organization": "<your Azure Devops Organization",
    "Wikis": [
      {
        "Project": "<a project name>",
        "WikiName": "<a wiki name>"
      },
      {
        "Project": "<a project name",
        "WikiName": "<a wiki name>"
      }
    ]
  },
  "Parameters": {
    "ADOPAT": "<your Azure DevOps PAT token>"
  }

}
